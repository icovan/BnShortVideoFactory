// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  productName: 'BnShortVideoFactory',
  appId: 'com.bn.shortvideofactory',
  asar: true,
  directories: {
    output: 'release/${version}',
    buildResources: 'build/icons',
  },
  files: ['dist', 'dist-electron', 'dist-native', 'locales'],
  npmRebuild: false, // disable rebuild node_modules 使用包内自带预构建二进制，而不重新构建
  beforePack: './build/scripts/before-pack.js',
  // 引擎源码（stage-engine 已排除 node_modules；skills 仅 BIUNOW_INCLUDE_SKILLS=1 时打入）
  extraResources: [
    {
      from: 'build/engine-stage',
      to: 'create-core',
      filter: ['**/*'],
    },
    {
      from: 'config',
      to: 'config',
      filter: ['commerce.json'],
    },
  ],
  mac: {
    target: [
      {
        target: 'dmg',
        arch: ['universal'],
      },
    ],
    artifactName: '${name}-${version}-mac-${arch}-installer.${ext}',
    icon: './public/icon.png',
  },
  win: {
    target: [
      {
        target: 'nsis',
      },
    ],
    artifactName: '${name}-${version}-win-${arch}-setup.${ext}',
    // 必须用多尺寸 .ico；单张 png 缩放后任务栏/桌面快捷方式易发糊
    icon: './build/icons/icon.ico',
  },
  nsis: {
    language: '0x0804',
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    // 安装器 / 卸载器 / 进度条头图都用同一套多尺寸 ico（360/火绒常读安装器或卸载注册表图标）
    installerIcon: 'icon.ico',
    uninstallerIcon: 'icon.ico',
    installerHeaderIcon: 'icon.ico',
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${name}-${version}-linux-${arch}.${ext}',
    icon: './public/icon.png',
  },
  publish: null, // disable auto publish 防止重复发版
}
