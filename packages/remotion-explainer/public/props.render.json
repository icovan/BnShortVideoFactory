sfxFile":"sfx/iface-toggle-001.ogg","sfxVolume":0.147,"sfxRole":"snap"},{"job":"escalation","durationSec":3.024,"vo":"囚犯开始对着麦克风低声说话……","headline":"对着麦克风","visualIntent":"麦克风波形微微跳动；耳机图标旁浮出低语字幕；声波被压暗，房间阴影加深。","keyMotion":"低声波形","skill":"caption-animation","narrationFile":"vo-9.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/iface-drop-001.ogg","volume":0.129,"atSec":0.04}],"sfxFile":"sfx/iface-drop-001.ogg","sfxVolume":0.129,"sfxRole":"tick"},{"job":"escalation","durationSec":2.784,"vo":"然后，他们开始互相攻击。","headline":"互相攻击","visualIntent":"监控画面快速切换；剪影互相扭打；警报灯闪一下又熄灭；镜头轻微手持晃动。","keyMotion":"剪影扭打","skill":"kinetic-typography","narrationFile":"vo-10.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/iface-switch-003.ogg","volume":0.147,"atSec":0.04}],"sfxFile":"sfx/iface-switch-003.ogg","sfxVolume":0.147,"sfxRole":"snap"},{"job":"escalation","durationSec":3.648,"vo":"第九天，一个人连续尖叫了三个小时……","headline":"第九天","visualIntent":"时间码跳到 DAY 09；声波峰值拉满并爆裂；喉部图标出现裂纹；三小时计时器飞转。","keyMotion":"声波爆裂","skill":"chart-animation","narrationFile":"vo-11.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/iface-tick-001.ogg","volume":0.129,"atSec":0.04}],"sfxFile":"sfx/iface-tick-001.ogg","sfxVolume":0.129,"sfxRole":"tick"},{"job":"consequence","durationSec":2.976,"vo":"直到他的声带被彻底损坏。","headline":"声带损坏","visualIntent":"声带剖面图放大，纤维断裂；音频波形归零；冷白闪断一次。","keyMotion":"声带断裂","skill":"diagram-animation","narrationFile":"vo-12.mp3","sfxCues":[{"role":"whoosh","intent":"enter","file":"sfx/iface-maximize-003.ogg","volume":0.166,"atSec":0.04}],"sfxFile":"sfx/iface-maximize-003.ogg","sfxVolume":0.166,"sfxRole":"whoosh"},{"job":"silence","durationSec":3.36,"vo":"然后，一切陷入死寂，没有声音。","headline":"死寂","visualIntent":"所有波形瞬间拉平；监控只剩雪花；画面静帧，声音图标被划掉。","keyMotion":"波形拉平","skill":"caption-animation","narrationFile":"vo-13.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/iface-tick-002.ogg","volume":0.129,"atSec":0.04}],"sfxFile":"sfx/iface-tick-002.ogg","sfxVolume":0.129,"sfxRole":"tick"},{"job":"discovery","durationSec":2.976,"vo":"第十五天，那间密室被打开。","headline":"第十五天","visualIntent":"时间码跳到 DAY 15；密封门液压杆开启；冷光从门缝刺入；满幅舱门视角。","keyMotion":"舱门开启","skill":"kinetic-typography","narrationFile":"vo-14.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/kenney-switch-1.wav","volume":0.156,"atSec":0.04}],"sfxFile":"sfx/kenney-switch-1.wav","sfxVolume":0.156,"sfxRole":"snap"},{"job":"discovery","durationSec":3.408,"vo":"囚犯还活着，但他们已经不像人了。","headline":"不像人了","visualIntent":"五人剪影站在暗处；人形轮廓出现畸变；眼球反光冷白；镜头缓慢推近。","keyMotion":"人形畸变","skill":"kinetic-typography","narrationFile":"vo-15.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/iface-toggle-003.ogg","volume":0.147,"atSec":0.04}],"sfxFile":"sfx/iface-toggle-003.ogg","sfxVolume":0.147,"sfxRole":"snap"},{"job":"horror","durationSec":4.824,"vo":"最恐怖的是什么？他们竟然在乞求那种气体。","headline":"乞求气体","visualIntent":"手从铁栏伸出，抓向气体管道；气体粒子被吸回房间；“乞求”字幕压暗。","keyMotion":"伸手乞求","skill":"kinetic-typography","narrationFile":"vo-16.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/iface-switch-001.ogg","volume":0.147,"atSec":0.04}],"sfxFile":"sfx/iface-switch-001.ogg","sfxVolume":0.147,"sfxRole":"snap"},{"job":"quote","durationSec":2.544,"vo":"最后，一名囚犯开口说……","headline":"囚犯开口","visualIntent":"唯一亮起的脸在暗处；嘴部微动；字幕逐字浮现；背景噪声压低。","keyMotion":"字幕浮现","skill":"caption-animation","narrationFile":"vo-17.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/kenney-switch-2.wav","volume":0.138,"atSec":0.04}],"sfxFile":"sfx/kenney-switch-2.wav","sfxVolume":0.138,"sfxRole":"tick"},{"job":"quote","durationSec":3.816,"vo":"“我们，就是藏在你们每个人心里的东西……”","headline":"心里的东西","visualIntent":"文字从观众视角胸腔位置爬出；无数观众剪影被同一句字幕穿过；画面变冷。","keyMotion":"文字爬出","skill":"kinetic-typography","narrationFile":"vo-18.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/switch.wav","volume":0.156,"atSec":0.04}],"sfxFile":"sfx/switch.wav","sfxVolume":0.156,"sfxRole":"snap"},{"job":"quote","durationSec":4.536,"vo":"“那种疯狂，那种只有睡眠才能暂时压住的东西。”","headline":"睡眠压住疯狂","visualIntent":"脑图上的疯狂曲线冲高；睡眠波形将其暂时压平；随后再次反弹；图表满幅。","keyMotion":"曲线反弹","skill":"chart-animation","narrationFile":"vo-19.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/iface-tick-004.ogg","volume":0.129,"atSec":0.04}],"sfxFile":"sfx/iface-tick-004.ogg","sfxVolume":0.129,"sfxRole":"tick"},{"job":"reveal","durationSec":3.72,"vo":"但反转是——这个故事根本没发生过。","headline":"反转：没发生","visualIntent":"档案照片被盖上“虚构”印章；证据文件夹打开为空；冷白闪回一次。","keyMotion":"印章盖下","skill":"kinetic-typography","narrationFile":"vo-20.mp3","sfxCues":[{"role":"impact","intent":"enter","file":"sfx/impact-generic-001.ogg","volume":0.147,"atSec":0.04}],"sfxFile":"sfx/impact-generic-001.ogg","sfxVolume":0.147,"sfxRole":"impact"},{"job":"reveal","durationSec":4.872,"vo":"它只是 2010 年发布在恐怖故事网站上的虚构作品。","headline":"2010虚构作品","visualIntent":"浏览器窗口显示 2010 年时间戳；恐怖故事网站页面滚动；页面标注“虚构作品”。","keyMotion":"网页滚动","skill":"caption-animation","narrationFile":"vo-21.mp3","sfxCues":[{"role":"impact","intent":"enter","file":"sfx/dramatic-boomer.wav","volume":0.166,"atSec":0.04}],"sfxFile":"sfx/dramatic-boomer.wav","sfxVolume":0.166,"sfxRole":"impact"},{"job":"evidence","durationSec":2.904,"vo":"关于这个实验，没有任何证据。","headline":"没有证据","visualIntent":"档案袋倒出空白纸张；证据链断开；红色叉号划过；画面留黑。","keyMotion":"证据清空","skill":"kinetic-typography","narrationFile":"vo-22.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/iface-switch-003.ogg","volume":0.147,"atSec":0.04}],"sfxFile":"sfx/iface-switch-003.ogg","sfxVolume":0.147,"sfxRole":"snap"},{"job":"science","durationSec":4.2,"vo":"可即便如此，睡眠剥夺却是真实存在的。","headline":"睡眠剥夺真实","visualIntent":"从传说页面切到真实医学图表；脑部扫描冷蓝；睡眠剥夺数据曲线上升。","keyMotion":"切到医学","skill":"chart-animation","narrationFile":"vo-23.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/iface-drop-001.ogg","volume":0.129,"atSec":0.04}],"sfxFile":"sfx/iface-drop-001.ogg","sfxVolume":0.129,"sfxRole":"tick"},{"job":"science","durationSec":3.888,"vo":"只要几天不睡，大脑就会开始出现幻觉。","headline":"几天不睡","visualIntent":"脑电波进入异常震荡；视觉噪点变成幻影；日历翻过三天；画面出现重影。","keyMotion":"脑波震荡","skill":"chart-animation","narrationFile":"vo-24.mp3","sfxCues":[{"role":"tick","intent":"enter","file":"sfx/iface-tick-001.ogg","volume":0.129,"atSec":0.04}],"sfxFile":"sfx/iface-tick-001.ogg","sfxVolume":0.129,"sfxRole":"tick"},{"job":"cta","durationSec":3.504,"vo":"所以问题来了……你，能撑多久不睡？","headline":"你能撑多久？","visualIntent":"黑场中倒计时从 72 小时快速回落；镜头推近观众瞳孔；主标题最后以 ≥72 字号砸入满幅。","keyMotion":"倒计时坠落","skill":"kinetic-typography","narrationFile":"vo-25.mp3","sfxCues":[{"role":"snap","intent":"enter","file":"sfx/kenney-switch-1.wav","volume":0.156,"atSec":0.04},{"role":"confirm","intent":"settle","file":"sfx/iface-confirm-003.ogg","volume":0.13,"atSec":3.184}],"sfxFile":"sfx/kenney-switch-1.wav","sfxVolume":0.156,"sfxRole":"snap"}],"captions":[{"from":0.05,"to":4.92,"text":"想象一下。五个人。\n一间完全密封的密室。"},{"from":5.09,"to":7.896,"text":"他们整整十五天，不许睡觉。"},{"from":8.066,"to":13.704,"text":"这就是“俄罗斯睡眠实验”，\n网上最让人毛骨悚然的都市传说之一。"},{"from":13.874,"to":20.16,"text":"据说，上世纪四十年代，\n苏联研究人员把五名政治犯关进了一间气密室。"},{"from":20.330000000000002,"to":23.424,"text":"他们在里面释放了一种实验性气体。"},{"from":23.594,"to":26.592,"text":"这种气体能彻底压制睡眠。"},{"from":26.762,"to":30.768,"text":"条件很简单：三十天不睡，\n就能重获自由。"},{"from":30.938,"to":33.696,"text":"前五天里，一切还算正常。"},{"from":33.86599999999999,"to":36.504,"text":"可很快，偏执感开始出现。"},{"from":36.67399999999999,"to":39.52799999999999,"text":"囚犯开始对着麦克风低声说话……"},{"from":39.69799999999999,"to":42.312,"text":"然后，他们开始互相攻击。"},{"from":42.48199999999999,"to":45.959999999999994,"text":"第九天，一个人连续\n尖叫了三个小时……"},{"from":46.129999999999995,"to":48.936,"text":"直到他的声带被彻底损坏。"},{"from":49.105999999999995,"to":52.296,"text":"然后，一切陷入死寂，没有声音。"},{"from":52.465999999999994,"to":55.272,"text":"第十五天，那间密室被打开。"},{"from":55.44199999999999,"to":58.67999999999999,"text":"囚犯还活着，但他们已经不像人了。"},{"from":58.849999999999994,"to":63.504,"text":"最恐怖的是什么？他们\n竟然在乞求那种气体。"},{"from":63.67399999999999,"to":66.048,"text":"最后，一名囚犯开口说……"},{"from":66.21799999999999,"to":69.86399999999999,"text":"“我们，就是藏在你们每\n个人心里的东西……”"},{"from":70.03399999999999,"to":74.39999999999999,"text":"“那种疯狂，那种只有睡眠\n才能暂时压住的东西。”"},{"from":74.57,"to":78.11999999999999,"text":"但反转是——这个故\n事根本没发生过。"},{"from":78.28999999999999,"to":82.99199999999999,"text":"它只是 2010 年发布在\n恐怖故事网站上的虚构作品。"},{"from":83.16199999999999,"to":85.896,"text":"关于这个实验，没有任何证据。"},{"from":86.06599999999999,"to":90.09599999999999,"text":"可即便如此，睡眠剥\n夺却是真实存在的。"},{"from":90.26599999999999,"to":93.984,"text":"只要几天不睡，大脑\n就会开始出现幻觉。"},{"from":94.154,"to":97.488,"text":"所以问题来了……你，\n能撑多久不睡？"}]}